#: assets/editor.js:101
msgid "Organisation detail (link)"
msgstr "Information de l’organisation (lien)"

#: assets/editor.js:132
msgid "(empty)"
msgstr "(vide)"

#: assets/editor.js:141
msgid "Copy the shortcode"
msgstr "Copier le shortcode"

#: assets/editor.js:153
msgid "Help"
msgstr "Aide"

#: assets/editor.js:154
msgid "Details are entered once, in Organisation (admin menu). Every page shows the current value, in its own language."
msgstr "Les informations se saisissent une fois, dans Organisation (menu de l’administration). Chaque page affiche la valeur à jour, dans sa langue."

#: assets/editor.js:158
msgid "In a sentence: click the building icon of the block toolbar and choose a detail, as text or as a link."
msgstr "Dans une phrase : cliquez sur l’icône immeuble de la barre d’outils du bloc et choisissez une information, en texte ou en lien."

#: assets/editor.js:159
msgid "For a whole block (button, social icon): Block settings › Attributes › Organisation details."
msgstr "Pour un bloc entier (bouton, icône de réseau social) : Réglages du bloc › Attributs › Informations de l’organisation."

#: assets/editor.js:160
msgid "Or copy a shortcode below and paste it in the text. Add link=\"1\" to make it a link, text=\"…\" for your own wording."
msgstr "Ou copiez un shortcode ci-dessous et collez-le dans le texte. Ajoutez link=\"1\" pour en faire un lien, text=\"…\" pour votre propre formulation."

#: assets/editor.js:163
msgid "Edit the organisation details"
msgstr "Modifier les informations de l’organisation"

